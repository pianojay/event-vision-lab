; Event Vision Lab: a controlled shader-based simulation, not a game.
config_version=5

[application]
config/name="Event Vision Lab"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[display]
window/size/viewport_width=1180
window/size/viewport_height=860
window/size/window_width_override=1180
window/size/window_height_override=860
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="vulkan"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.055, 1)
